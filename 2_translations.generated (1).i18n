    "You pay directly via your bank account.": {
        "de-CH": "Du bezahlst direkt über dein Bankkonto",
        "en-US": "You pay directly via your bank account.",
        "fr-CH": "Vous payez directement via votre compte bancaire.",
        "it-CH": "Paghi direttamente tramite il tuo conto bancario.",
        "nl-NL": "Je betaalt rechtstreeks via je bankrekening."
    },
    "You pay with Klarna, the payment method that provides additional payment options: Pay immediately via online banking, pay later, or in instalments with direct debit.": {
        "de-CH": "Du bezahlst mit Klarna und entscheidest selbst, ob du sofort per Online-Banking, später oder in Raten per Bankeinzug bezahlst.",
        "en-US": "Pay with Klarna and choose whether to pay now via online banking, later, or in direct debit instalments.",
        "fr-CH": "Payez avec Klarna et choisissez votre paiement immédiat, différé ou en plusieurs fois via le service de banque en ligne.",
        "it-CH": "Paga con Klarna e scegli se pagare subito tramite e-banking, in un secondo momento, o a rate con addebito diretto.",
        "nl-NL": "Je betaalt met Klarna, de betaalmethode die extra betaalmogelijkheden biedt: Direct betalen via internetbankieren, later betalen of in termijnen met automatische incasso."
    },
    "You pay with prepayment ([0]). The goods are shipped as soon as we receive your payment.": {
        "de-CH": "Du bezahlst per Vorauszahlung ([0]). Der Versand erfolgt nach Zahlungseingang.",
        "en-US": "You've chosen advance payment ([0]). The goods are shipped as soon as we receive your payment.",
        "fr-CH": "Vous réglez en paiement anticipé ([0]). L’expédition a lieu après réception du paiement.",
        "it-CH": "Hai scelto il pagamento anticipato ([0]). La spedizione avviene dopo la ricezione del pagamento.",
        "nl-NL": "Je hebt gekozen voor vooruitbetaling ([0]). De goederen worden verzonden zodra we je betaling hebben ontvangen."
