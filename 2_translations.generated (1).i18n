    "The order amount exceeds your credit limit.": {
        "de-CH": "Dein Warenkorbwert übersteigt dein Kreditlimit.",
        "en-US": "The order amount exceeds your credit limit.",
        "fr-CH": "Le montant de votre panier dépasse votre limite de crédit autorisée.",
