    "ProductAccesoriesMetaDescription [0]": {
        "de-CH": "Entdecke Zubehör für [0] - ✔ Top Service und Beratung ✔ Schnelle Lieferung ✔ Starke Community",
        "en-US": "Discover accessories for [0] - ✔ Top service and advice ✔ Fast delivery ✔ Strong community",
        "fr-CH": "Découvre les accessoires pour [0] - ✔ Service et conseils de qualité ✔ Livraison rapide ✔ Forte communauté",
        "it-CH": "Scopri gli accessori per [0] - ✔ Servizio e consigli migliori ✔ Consegna veloce ✔ Comunità forte",
        "nl-NL": "Ontdek accessoires voor [0] - ✔ Top service en advies ✔ Snelle levering ✔ Sterke gemeenschap"
    },
    "ProductAdviceResponseGenericHA": {
        "de-CH": "Fragen zu einem bereits auf Galaxus vorhandenen Produkt kannst du auf der jeweiligen Produktseite erfassen. Unsere Community antwortet in der Regel innerhalb von wenigen Stunden. Das Beste: Alle profitieren von deinem Beitrag.",
        "en-US": "Questions about a product already available on Galaxus can be entered on the relevant product page. Our community usually responds within a few hours. The best thing: everyone benefits from your contribution.",
        "fr-CH": "Les questions concernant un produit déjà disponible sur Galaxus peuvent être posées sur la page du produit concerné. Notre communauté y répond généralement en quelques heures. Et le plus beau, c'est que tout le monde profite de votre contribution.",
        "it-CH": "Le domande su un prodotto già disponibile su Galaxus possono essere inserite nella relativa pagina del prodotto. La nostra comunità risponde solitamente entro poche ore. La cosa migliore è che tutti beneficiano del vostro contributo.",
        "nl-NL": "Vragen over een product dat al beschikbaar is op Galaxus kunnen worden ingevoerd op de relevante productpagina. Onze community reageert meestal binnen een paar uur. Het beste is: iedereen profiteert van uw bijdrage."
    },
    "ProductAdviceResponseHA": {
        "de-CH": "Fragen zu dem Produkt kannst du unserer Community stellen. Sie antwortet dir in der Regel innerhalb von wenigen Stunden. Das Beste: Alle profitieren von deinem Beitrag.",
        "en-US": "You can ask our community questions about the product. They will usually answer you within a few hours. The best thing is that everyone benefits from your contribution.",
        "fr-CH": "Vous pouvez poser à notre communauté des questions sur le produit. Ils vous répondront généralement dans les heures qui suivent. Le plus beau, c'est que tout le monde profite de votre contribution.",
        "it-CH": "È possibile porre alla nostra comunità domande sul prodotto. Di solito vi risponderanno entro poche ore. La cosa migliore è che tutti beneficiano del vostro contributo.",
        "nl-NL": "Je kunt onze community vragen stellen over het product. Meestal krijg je binnen een paar uur antwoord. Het beste is dat iedereen profiteert van jouw bijdrage."
    },
    "ProductRatingConclusionPlaceholder": {
        "de-CH": "Deine Meinung, kurz und knapp",
        "en-US": "Your opinion, short and sweet",
        "fr-CH": "Votre opinion, courte et douce",
        "it-CH": "La tua opinione, breve e dolce",
