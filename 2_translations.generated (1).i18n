    "flashDelivery.shippingAdvertisement.description": {
        "de-CH": "An deine Adresse liefern wir noch schneller. Wechsle jetzt auf die Blitzlieferung, um davon zu profitieren.",
        "en-US": "We can deliver your order even faster to your address. Switch to flash delivery.",
