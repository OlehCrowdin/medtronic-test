    },
    "You redeem one or more credit notes which have together a value of [0].": {
        "de-CH": "Du löst Gutschriften im Wert von [0] ein.",
        "en-US": "You’re redeeming credit notes worth a total of [0].",
        "fr-CH": "Vous utilisez un ou plusieurs avoirs d’une valeur totale de [0].",
        "it-CH": "Stai riscattando crediti per un valore di [0].",
        "nl-NL": "Je wisselt tegoedbonnen in met een totale waarde van [0]."
