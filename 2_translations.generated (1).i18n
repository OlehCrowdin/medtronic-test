    "DeleteWatchListFirstParagraph": {
        "de-CH": "Möchtest du wirklich deine komplette Merkliste löschen?",
        "en-US": "Are you sure you want to delete your entire watch list?",
        "fr-CH": "Voulez-vous vraiment supprimer toute votre liste d’envies?",
        "it-CH": "Vuoi davvero rimuovere l'intera lista dei desideri?",
        "nl-NL": "Wil je echt je hele volglijst verwijderen?"
