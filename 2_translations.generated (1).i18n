    "ai_loading_text_1": {
        "de-CH": "Wir werfen einen Blick in die Daten. Vielleicht finden wir direkt eine Antwort!",
        "en-US": "We're taking a look at the data. Maybe we'll find an answer straight away!",
        "fr-CH": "Nous jetons un œil aux données. Nous trouverons peut-être une réponse tout de suite !",
        "it-CH": "Stiamo controllando i dati. Forse riusciamo a trovare subito una risposta.",
        "nl-NL": "Laten we eens naar de gegevens kijken. Misschien vinden we meteen een antwoord!"
    },
    "ai_loading_text_2": {
        "de-CH": "Die Antwort spielt Verstecken. Wir geben nicht auf …",
        "en-US": "The answer's playing hide and seek... but we're not giving up!",
        "fr-CH": "La réponse joue à cache-cache... nous continuons la recherche !",
        "it-CH": "La risposta è nascosta, ma non ci arrendiamo!",
        "nl-NL": "Het antwoord is verstoppertje spelen. We geven niet op ..."
    },
    "ai_loading_text_3": {
        "de-CH": "Einen Moment noch. Die Antwort ist wohl etwas schüchtern …",
        "en-US": "Just a moment longer. The answer's playing hard to get...",
        "fr-CH": "Encore un instant. La réponse a l'air un peu timide...",
